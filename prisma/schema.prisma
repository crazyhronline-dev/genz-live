// GenZ Live — Prisma Schema for MySQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  icon      String
  articles  Article[]
  createdAt DateTime @default(now())
}

model Article {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String    @db.Text
  subtitle     String?   @db.Text
  content      String    @db.LongText
  categorySlug String
  category     Category  @relation(fields: [categorySlug], references: [slug])
  author       String
  authorRole   String?
  authorAvatar String?
  publishedAt  String
  readTime     String
  views        String    @default("0")
  likes        Int       @default(0)
  image        String
  isFeatured   Boolean   @default(false)
  comments     Comment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      String
  text      String   @db.Text
  createdAt DateTime @default(now())
}
