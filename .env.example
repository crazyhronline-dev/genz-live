# ================================================================
# GenZ Live — Environment Variables
# Copy this file to .env and fill in values for your environment.
# NEVER commit your .env file to version control.
# ================================================================

# ----------------------------------------------------------------
# DATABASE — MySQL (Hostinger / any MySQL 8.x provider)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# ----------------------------------------------------------------
DATABASE_URL="mysql://genzlive_user:YOUR_PASSWORD@localhost:3306/genzlive_db"

# ----------------------------------------------------------------
# NEXT.JS
# ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://genz-live.com"
NEXT_PUBLIC_GA_ID=""

# ----------------------------------------------------------------
# AUTHENTICATION (Phase 2 — NextAuth.js)
# ----------------------------------------------------------------
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://genz-live.com"

# ----------------------------------------------------------------
# EMAIL (Newsletter + Contact form)
# ----------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@genz-live.com"

# ----------------------------------------------------------------
# MEDIA STORAGE (Phase 3 — Cloudflare R2 / AWS S3)
# ----------------------------------------------------------------
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
