# ================================================================
# GenZ Live — Environment Variables Template
# ================================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in all values for your environment
#   3. NEVER commit .env to version control — it is in .gitignore
# ================================================================

# ----------------------------------------------------------------
# SITE — Public site identity (safe to expose in the browser)
# ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://genz-live.com
NEXT_PUBLIC_SITE_NAME=GenZ Live
NEXT_PUBLIC_SITE_TAGLINE=The Voice of GenZ

# ----------------------------------------------------------------
# DATABASE — MySQL 8.x
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# ----------------------------------------------------------------
DATABASE_URL=mysql://genzlive_user:YOUR_STRONG_PASSWORD@localhost:3306/genzlive_db
ENABLE_DB_PRISMA=false

# ----------------------------------------------------------------
# AUTHENTICATION — Admin CMS Secret (Generate with: openssl rand -base64 32)
# ----------------------------------------------------------------
AUTH_SECRET=
ADMIN_EMAIL=admin@genz-live.com
ADMIN_PASSWORD=

# ----------------------------------------------------------------
# AI NEWSROOM ENGINE — Server-side AI provider configuration
# ----------------------------------------------------------------
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# ----------------------------------------------------------------
# EMAIL — SMTP for newsletter confirmation and contact form
# ----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@genz-live.com

# ----------------------------------------------------------------
# YOUTUBE — Channel data
# ----------------------------------------------------------------
NEXT_PUBLIC_YOUTUBE_HANDLE=@genz-live-official
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://youtube.com/@genz-live-official

# ----------------------------------------------------------------
# SOCIAL — Public social profile URLs
# ----------------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/genzliveofficial
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/genzliveofficial
NEXT_PUBLIC_TWITTER_URL=https://x.com/genzliveofficial
